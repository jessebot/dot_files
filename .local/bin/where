#!/usr/bin/env bash
# script by jessebot, License: AGPL

export arg="$1"

# if `which $arg` returns an exit code that isn't 0 (success)
if ! which "$arg"; then
    # this is for debugging
    # echo -e "\e[33mLooks like there's no $arg command in your PATH, maybe it's an alias?\e[0m 🤔"

    # grab all the user's aliases
    bash -i -c "alias -p > /tmp/aliases" > /dev/null

    # then check if there's an alias for that command
    alias_command=$(grep "$arg=" /tmp/aliases | cut -d '=' -f 2 | tr -d "'")

    # if the above alias check returned anything
    if [[ $alias_command ]]; then
        # get the actual locaiton of the aliased command
        location=$(which "$alias_command")

        echo -e "Looks like \e[33m$arg\e[0m is aliased to \e[33m$alias_command\e[0m which lives in:"
        echo -e "\e[32m$location\e[0m"
    else
        echo -e "\e[31mCouldn't find an alias for the command either\e[0m 😔"
    fi
fi
